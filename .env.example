# Copy to .env and fill in. Never commit the filled-in version.
# Register an app at https://developer.schwab.com (Market Data Production).

SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# mock (default, synthetic) | schwab
GEXDASH_PROVIDER=mock

# Where the chain cache and OAuth token live. Defaults to ~/.gexdash
# GEXDASH_HOME=~/.gexdash

# Override exercise style per instrument, e.g. if your chain is mostly CME
# weeklies (European) rather than quarterlies (American). Malformed entries
# raise at import rather than being silently skipped.
# GEXDASH_EXERCISE_OVERRIDES=NDX=american,NQ=european

# GEXDASH_HOST=127.0.0.1
# GEXDASH_PORT=8420
